+#define HX_BUS_W_CMD     0xf2u
+#define HX_AHB_ADDR_CMD  0x00u
+#define HX_AHB_RDATA     0x08u
+#define HX_AHB_DIR       0x0cu
+#define HX_AHB_DIR_READ  0x00u
+#define HX_AHB_CONT      0x13u
+#define HX_AHB_INC4      0x0du
+#define HX_FW_VER        0x10007004u
+#define HX_FW_STATE      0x900000f8u
+#define HX_CHK_FW_STATUS 0x900000a8u
+#define HX_RESET_EVENT   0x900000e4u
+#define HX_LEAVE_SAFE    0x90000098u
+
+static void
+hx_put_be32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+/* Vendor himax_bus_write(): [F2, cmd, addr(4B big endian)?, data], TX only. */
+static int
+himax_write_raw(uint8_t cmd, const uint8_t *addr4, const uint8_t *data, unsigned len)
+{
+	uint8_t tx[2u + 4u + 64u];
+	unsigned n = 2;
+
+	if (len > 64u) {
+		return -1;
+	}
+	tx[0] = HX_BUS_W_CMD;
+	tx[1] = cmd;
+	if (addr4) {
+		memcpy(tx + n, addr4, 4);
+		n += 4;
+	}
+	if (data && len) {
+		memcpy(tx + n, data, len);
+		n += len;
+	}
+	return rain_spi(RAIN_OP_TX, tx, NULL, n);
+}
+
+/* hx83112f_burst_enable(): AHB continuous mode plus 4-byte auto increment. */
+static void
+himax_burst(int on)
+{
+	uint8_t d;
+
+	d = 0x31u;
+	(void)himax_write_raw(HX_AHB_CONT, NULL, &d, 1);
+	d = (uint8_t)(0x10u | (on ? 1u : 0u));
+	(void)himax_write_raw(HX_AHB_INC4, NULL, &d, 1);
+}
+
+/* hx83112f_register_write() with one 32-bit value. */
+static int
+himax_ahb_write(uint32_t addr, uint32_t val)
+{
+	uint8_t a[4], d[4];
+
+	himax_burst(0);
+	hx_put_be32(a, addr);
+	hx_put_be32(d, val);
+	return himax_write_raw(HX_AHB_ADDR_CMD, a, d, 4);
+}
+
+/* hx83112f_register_read(): address, access direction, then the 0x08 bank. */
+static int
+himax_ahb_read(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t a[4], dir = HX_AHB_DIR_READ;
+	int e;
+
+	if (len > 64u) {
+		return -1;
+	}
+	himax_burst(0);
+	hx_put_be32(a, addr);
+	e = himax_write_raw(HX_AHB_ADDR_CMD, a, NULL, 0);
+	if (e) {
+		return e;
+	}
+	e = himax_write_raw(HX_AHB_DIR, NULL, &dir, 1);
+	if (e) {
+		return e;
+	}
+	return himax_read(HX_AHB_RDATA, buf, len);
+}
