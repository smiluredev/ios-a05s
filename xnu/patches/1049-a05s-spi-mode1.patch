 	touch_wr(rn.se, RAIN_SPI_DEMUXSEL, a05s_touch ? 2u : 0u); /* a05s: CS2, rain: CS0 */
 	touch_wr(rn.se, RAIN_SPI_DEMUXINV, 0);
