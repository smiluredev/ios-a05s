 /* himax_mcu_firmware_update_0f + _power_on_init, with the GPIO 86 pin reset
  * that makes the zero-flash part boot the image just written to SRAM. */
 static int
+himax_read_dbg(uint8_t cmd, uint8_t *buf, unsigned len)
+{
+	uint8_t tx[3u + 16u], rx[3u + 16u];
+	unsigned i;
+	int e;
+
+	if (len > 16u) {
+		len = 16u;
+	}
+	bzero(tx, sizeof(tx));
+	bzero(rx, sizeof(rx));
+	tx[0] = 0xf3u;
+	tx[1] = cmd;
+	e = rain_spi(RAIN_OP_FULL, tx, rx, 3u + len);
+	printf("A05S TOUCH: read %02x e=%d rx", cmd, e);
+	for (i = 0; i < 3u + len; i++) {
+		printf(" %02x", rx[i]);
+	}
+	printf("\n");
+	if (!e) {
+		memcpy(buf, rx + 3, len);
+	}
+	return e;
+}
+
+static int
+himax_ahb_read_dbg(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	uint8_t a[4], dir = 0;
+	int e;
+
+	himax_burst(0);
+	hx_put_le32(a, addr);
+	e = himax_write_raw(HX_AHB_ADDR_CMD, a, NULL, 0);
+	if (e) {
+		return e;
+	}
+	e = himax_write_raw(HX_AHB_DIR, NULL, &dir, 1);
+	if (e) {
+		return e;
+	}
+	return himax_read_dbg(HX_AHB_RDATA, buf, len);
+}
