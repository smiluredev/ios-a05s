 static void a05s_touch_run(void);
 
+/* One-boot identification: Himax, Ilitek or an I2C touch, and is MISO alive? */
+extern int sweet_i2c_bus_read(int bus, uint8_t addr, uint8_t reg,
+    uint8_t *buf, unsigned len);
+
+static void
+a05s_ident(void)
+{
+	static const struct {
+		const char *name;
+		uint8_t tx[8];
+	} pat[] = {
+		{ "himax", { 0xf3, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 } },
+		{ "ilird", { 0x83, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 } },
+		{ "iliwr", { 0x82, 0x00, 0x04, 0x40, 0x00, 0x00, 0x00, 0x00 } },
+		{ "ff",    { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff } },
+	};
+	static const unsigned cs[2] = { 0, 2 };
+	static const unsigned cpha[2] = { 0, 1 };
+	static const unsigned cpol[2] = { 0, 4 };
+	uint8_t rx[8], b[2];
+	unsigned a, m, p, k;
+	int e;
+
+	printf("A05S ID: irq io=%#x\n",
+	    touch_rd(st.west, TOUCH_GPIO_IO(TOUCH_PIN_IRQ)));
+	b[0] = b[1] = 0;
+	e = sweet_i2c_bus_read(2, 0x20, 0x00, b, 1);
+	printf("A05S ID: i2c 0x20 e=%d v=%02x\n", e, b[0]);
+	touch_wait(20);
+	b[0] = 0;
+	e = sweet_i2c_bus_read(2, 0x62, 0x00, b, 1);
+	printf("A05S ID: i2c 0x62 e=%d v=%02x\n", e, b[0]);
+	touch_wait(20);
+	for (a = 0; a < 2u; a++) {
+		for (m = 0; m < 2u; m++) {
+			for (p = 0; p < 2u; p++) {
+				touch_wr(rn.se, RAIN_SPI_DEMUXSEL, cs[a]);
+				touch_wr(rn.se, RAIN_SPI_CPHA, cpha[m]);
+				touch_wr(rn.se, RAIN_SPI_CPOL, cpol[p]);
+				for (k = 0; k < 4u; k++) {
+					bzero(rx, sizeof(rx));
+					(void)rain_spi(RAIN_OP_FULL, pat[k].tx, rx, 8);
+					printf("A05S ID: spi cs=%u cpha=%u cpol=%u %s rx %02x %02x %02x %02x %02x %02x %02x %02x\n",
+					    cs[a], cpha[m], cpol[p], pat[k].name,
+					    rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7]);
+					touch_wait(20);
+				}
+			}
+		}
+	}
+	touch_wr(rn.se, RAIN_SPI_DEMUXSEL, 2u);
+	touch_wr(rn.se, RAIN_SPI_CPHA, 1u);
+	touch_wr(rn.se, RAIN_SPI_CPOL, 4u);
+}
+
