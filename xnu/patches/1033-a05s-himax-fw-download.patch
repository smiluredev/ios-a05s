+/* AHB burst writes 4 bytes per word, so keep every chunk word aligned. */
+static int
+himax_write_sram(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	unsigned off = 0, chunks = 0;
+
+	while (off < len) {
+		unsigned n = len - off;
+		uint8_t a[4];
+		int e;
+
+		if (n > 60u) {
+			n = 60u;
+		}
+		n &= ~3u;
+		if (!n) {
+			return -1;
+		}
+		hx_put_le32(a, addr + off);
+		e = himax_write_raw(HX_AHB_ADDR_CMD, a, data + off, n);
+		if (e) {
+			return e;
+		}
+		off += n;
+		if ((++chunks & 7u) == 0u) {
+			touch_wait(1);
+		}
+	}
+	return 0;
+}
