+/* The FW rides in the boot payload as /chosen/memory-map a05sfw = <pa, len>
+ * (tools/mkpayload.py --blob), so it never has to live in git or in the root. */
+static int
+himax_fw_map(void)
+{
+	DTEntry mm;
+	void const *prop = NULL;
+	unsigned int psize = 0;
+	uint64_t pa, len;
+	vm_offset_t va;
+
+	if (hx_fw) {
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "a05sfw", &prop, &psize) != kSuccess ||
+	    psize < 16 || !prop) {
+		return -1;
+	}
+	pa = ((const uint64_t *)prop)[0];
+	len = ((const uint64_t *)prop)[1];
+	if (len < 0x20000u || len > (16u << 20)) {
+		return -1;
+	}
+	/* The shim's copy may still sit in the cache. */
+	flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+	va = ml_io_map((vm_offset_t)pa, (vm_size_t)len);
+	if (!va) {
+		return -1;
+	}
+	hx_fw = (const uint8_t *)va;
+	hx_fw_len = (unsigned)len;
+	printf("A05S TOUCH: fw blob pa=%#llx len=%u\n",
+	    (unsigned long long)pa, hx_fw_len);
+	return 0;
+}
+
+/* Partition table at 0x10400: {sram,size,fw_off,flags} little endian, 10 entries. */
+static int
+himax_fw_prepare(void)
+{
+	uint32_t sram[HX_FW_MAXPTR], sz[HX_FW_MAXPTR], off[HX_FW_MAXPTR];
+	uint32_t base = 0xffffffffu, end = 0;
+	unsigned pnum, i;
+
+	if (!hx_fw || hx_fw_len < HX_FW_TABLE + 16u * 2u) {
+		return -1;
+	}
+	pnum = hx_fw[HX_FW_TABLE + 12u];
+	if (pnum < 2u || pnum > HX_FW_MAXPTR) {
+		return -1;
+	}
+	for (i = 0; i < pnum; i++) {
+		const uint8_t *p = hx_fw + HX_FW_TABLE + i * 16u;
+		sram[i] = (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+		    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+		sz[i] = (uint32_t)p[4] | ((uint32_t)p[5] << 8) |
+		    ((uint32_t)p[6] << 16) | ((uint32_t)p[7] << 24);
+		off[i] = (uint32_t)p[8] | ((uint32_t)p[9] << 8) |
+		    ((uint32_t)p[10] << 16) | ((uint32_t)p[11] << 24);
+		if (!sz[i] || off[i] > hx_fw_len || sz[i] > hx_fw_len - off[i]) {
+			return -1;
+		}
+		if ((p[14] == 0x77u && p[15] == 0x88u) ||
+		    (p[14] == 0x55u && p[15] == 0x66u)) {
+			printf("A05S TOUCH: fw overlay section %u unsupported\n", i);
+			return -1;
+		}
+	}
+	for (i = 1; i < pnum; i++) {
+		if (sram[i] < base) {
+			base = sram[i];
+		}
+		if (sram[i] + sz[i] > end) {
+			end = sram[i] + sz[i];
+		}
+	}
+	if (base == 0xffffffffu || end <= base) {
+		return -1;
+	}
+	hx_cfg_sz = (end - base + 15u) & ~15u;
+	if (hx_cfg_sz > sizeof(hx_cfg)) {
+		return -1;
+	}
+	bzero(hx_cfg, sizeof(hx_cfg));
+	for (i = 1; i < pnum; i++) {
+		memcpy(hx_cfg + (sram[i] - base), hx_fw + off[i], sz[i]);
+	}
+	hx_fw_pa = sram[0];
+	hx_fw_off = off[0];
+	hx_fw_sz = sz[0];
+	hx_cfg_pa = base;
+	printf("A05S TOUCH: fw table pnum=%u fw=%#x+%u cfg=%#x+%u\n",
+	    pnum, hx_fw_pa, hx_fw_sz, hx_cfg_pa, hx_cfg_sz);
+	return 0;
+}
