+/* himax_mcu_firmware_update_0f + _power_on_init, with the GPIO 86 pin reset
+ * that makes the zero-flash part boot the image just written to SRAM. */
+static int
+himax_download(void)
+{
+	uint8_t v[4], d;
+	unsigned i, ok = 0;
+	int e;
+
+	printf("A05S TOUCH: fw download start\n");
+	(void)himax_ahb_write(HX_SYSTEM_RESET, 0x00000055u);
+	touch_wait(20);
+	{
+		uint8_t off[2] = { 0x27u, 0x95u };
+		(void)himax_write_raw(0x31u, NULL, off, 2);
+	}
+	touch_wait(20);
+	d = 0x00u;
+	(void)himax_write_raw(0x31u, NULL, &d, 1);
+	touch_wait(10);
+
+	himax_burst(1);
+	e = himax_write_sram(hx_fw_pa, hx_fw + hx_fw_off, hx_fw_sz);
+	printf("A05S TOUCH: fw entity e=%d\n", e);
+	if (!e) {
+		e = himax_write_sram(hx_cfg_pa, hx_cfg, hx_cfg_sz);
+	}
+	printf("A05S TOUCH: fw config e=%d\n", e);
+	himax_burst(0);
+	if (e) {
+		return e;
+	}
+
+	(void)himax_ahb_write(HX_FW_RELOAD, 0x00009aa9u);
+	(void)himax_ahb_write(HX_RAWOUT_SEL, 0);
+	(void)himax_ahb_write(HX_SORTING_MODE, 0);
+	(void)himax_ahb_write(HX_SET_FRAME, 1);
+	(void)himax_ahb_write(HX_FW_RELOAD2, 0);
+	(void)himax_ahb_write(HX_CTRL_FW, 0);
+	touch_wait(10);
+
+	touch_gpio(HX_GPIO_RST, 0, 0, 2, true, false);
+	touch_wait(2);
+	touch_gpio(HX_GPIO_RST, 0, 0, 2, true, true);
+	touch_wait(50);
+
+	(void)himax_ahb_write(HX_RELOAD_ACTIVE, 0x000000ecu);
+	for (i = 0; i < 30u; i++) {
+		bzero(v, sizeof(v));
+		(void)himax_ahb_read(HX_RELOAD_ACTIVE, v, 4);
+		if (v[0] == 0xecu && v[1] == 0x01u) {
+			ok = 1;
+			break;
+		}
+		touch_wait(10);
+	}
+	printf("A05S TOUCH: reload active ok=%u tries=%u\n", ok, i);
+	for (i = 0; i < 30u; i++) {
+		bzero(v, sizeof(v));
+		(void)himax_ahb_read(HX_FW_RELOAD2, v, 4);
+		if (v[0] == 0xc0u && v[1] == 0x72u) {
+			break;
+		}
+		touch_wait(10);
+	}
+	bzero(v, sizeof(v));
+	(void)himax_ahb_read(HX_FW_VER, v, 4);
+	printf("A05S TOUCH: fw reload2 tries=%u fw-ver %02x %02x %02x %02x\n",
+	    i, v[0], v[1], v[2], v[3]);
+	return 0;
+}
