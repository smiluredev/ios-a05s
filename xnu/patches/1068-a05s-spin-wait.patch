@@ -171,16 +170,25 @@
 touch_wait(unsigned ms)
 {
 	uint64_t deadline;
+
+	/*
+	 * 1068: spin on the hardware counter instead of assert_wait_deadline +
+	 * thread_block. The bw68/bw69 boots died on the 10th/11th 1 s wait (the
+	 * arm print came out, `wait woke` never did, then the root filesystem
+	 * stalled and the phone reset), so the sleep path itself is what breaks
+	 * here. This thread runs once at bring-up; spinning for a few seconds is
+	 * fine and removes the scheduler from the equation.
+	 */
 	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
-	boolean_t aw = assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
-	if (ms >= 1000u)
-		printf("A05S TOUCH: wait %u ms dl=%llu aw=%d\n", ms,
-			(unsigned long long)deadline, aw);
-	thread_block(THREAD_CONTINUE_NULL);
 	if (ms >= 1000u) {
-		sweet_log_mark("MARK wake\n");
-		printf("A05S TOUCH: wait woke %u ms\n", ms);
-		touch_sync();
+		printf("A05S TOUCH: wait %u ms dl=%llu\n", ms,
+		    (unsigned long long)deadline);
+	}
+	while (mach_absolute_time() < deadline) {
+		/* spin: no scheduler, no timers */
+	}
+	if (ms >= 1000u) {
+		printf("A05S TOUCH: wait done %u ms\n", ms);
 	}
 }
 
