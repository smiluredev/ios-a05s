+/*
+ * 1066: khaje has a single TLMM at 0x00400000 and its per-pin blocks start at
+ * 0x00401000, i.e. offset 0x1000*(pin+1); the block header at 0x400000 is not
+ * readable and an access to it hangs the bus (that is what killed bw62/63).
+ * rain/topaz keep the old 0x1000*pin layout inside their WEST/EAST tiles.
+ */
+static inline uint32_t
+touch_gpio_off(unsigned pin)
+{
+	return (uint32_t)((a05s_touch ? pin + 1u : pin) * 0x1000u);
+}
+#define TOUCH_GPIO_CFG(n) touch_gpio_off(n)
+#define TOUCH_GPIO_IO(n)  (touch_gpio_off(n) + 4u)
