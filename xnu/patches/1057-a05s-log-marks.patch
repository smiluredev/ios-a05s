+/*
+ * Write a line straight into the persistent log, bypassing the console.
+ * printf() goes through the console lock and the console driver, and on this
+ * port a print from the touch thread stops every console line in the kernel
+ * (the ring stops while the USB stack still answers), so a driver that wants
+ * to be seen must not depend on it. sweet_log_mark() appends and syncs
+ * immediately.
+ */
+void
+sweet_log_mark(const char *c)
+{
+	int n = 0;
+
+	while (c[n] != '\0' && n < 240) {
+		n++;
+	}
+	if (n == 0) {
+		return;
+	}
+	sweet_log_append(c, n);
+	sweet_log_sync();
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1003,6 +1026,17 @@
 			printf("SWEET LOG: write failed (%d) at %llu, retrying\n", error,
 			    (unsigned long long)total);
 			(void)tsleep(&sweet_log_chan, PZERO, "sweetlogfail", hz);
+			continue;
+		}
+		/*
+		 * Liveness mark in the ring itself (not on the console): if the
+		 * console dies but the kernel runs, these keep appearing.
+		 */
+		char hb[48];
+		int n = snprintf(hb, sizeof(hb), "SLOG %llu %llu\n",
+		    (unsigned long long)sweet_log_seq, (unsigned long long)total);
+		if (n > 0) {
+			sweet_log_append(hb, n);
 		}
 	}
 }
