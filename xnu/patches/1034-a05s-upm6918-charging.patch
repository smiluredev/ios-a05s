+/* A05s: UPM6918 charger on SE1 0x6b (DT: upm6918-charger@6b). The bootloader
+ * may leave it in HIZ or with a watchdog running, which stops charging once
+ * iOS takes over. Enable the charge path and disable the watchdog. */
+#define UPM6918_ADDR 0x6bu
+#define UPM_REG00    0x00u
+#define UPM_REG01    0x01u
+#define UPM_REG02    0x02u
+#define UPM_REG04    0x04u
+#define UPM_REG05    0x05u
+
+int
+sweet_a05s_charger_enable(void)
+{
+	uint8_t r0, r1, r2, r4, r5, n0, n1, n5;
+	int e;
+
+	if (sweet_i2c1_init()) {
+		printf("A05S CHG: SE1 not ready\n");
+		return ENXIO;
+	}
+	{
+		static const uint8_t alt[] = { 0x6bu, 0x6cu, 0x65u, 0x6du };
+		bool found = false;
+		for (unsigned i = 0; i < sizeof(alt); i++) {
+			uint8_t p = 0;
+			if (!sweet_i2c1_read(alt[i], UPM_REG00, &p, 1)) {
+				printf("A05S CHG: SE1 %02x answers %#x\n", alt[i], p);
+				if (alt[i] == UPM6918_ADDR) {
+					found = true;
+				}
+			}
+		}
+		if (!found) {
+			printf("A05S CHG: no upm6918 at SE1 0x6b\n");
+			return ENXIO;
+		}
+	}
+	if (sweet_i2c1_read(UPM6918_ADDR, UPM_REG00, &r0, 1) ||
+	    sweet_i2c1_read(UPM6918_ADDR, UPM_REG01, &r1, 1) ||
+	    sweet_i2c1_read(UPM6918_ADDR, UPM_REG02, &r2, 1) ||
+	    sweet_i2c1_read(UPM6918_ADDR, UPM_REG04, &r4, 1) ||
+	    sweet_i2c1_read(UPM6918_ADDR, UPM_REG05, &r5, 1)) {
+		printf("A05S CHG: upm6918 read failed\n");
+		return ENXIO;
+	}
+	printf("A05S CHG: upm6918 r0=%#x r1=%#x r2=%#x r4=%#x r5=%#x\n",
+	    r0, r1, r2, r4, r5);
+
+	/* REG00: ENHIZ (bit 7) 0 enables the input; keep IINLIM. */
+	n0 = (uint8_t)(r0 & ~0x80u);
+	/* REG01: CHG_CONFIG (bit 4) 1, WDT_RESET (bit 6) 1, OTG (bit 5) 0. */
+	n1 = (uint8_t)((r1 & ~0x20u) | 0x10u | 0x40u);
+	/* REG05: WDT (bits 5:4) 00 disables it; nobody kicks it from iOS. */
+	n5 = (uint8_t)(r5 & ~0x30u);
+
+	e = sweet_i2c1_write(UPM6918_ADDR, UPM_REG00, n0);
+	if (!e) {
+		e = sweet_i2c1_write(UPM6918_ADDR, UPM_REG01, n1);
+	}
+	if (!e) {
+		e = sweet_i2c1_write(UPM6918_ADDR, UPM_REG05, n5);
+	}
+	printf("A05S CHG: enable e=%d r0=%#x r1=%#x r5=%#x\n", e, n0, n1, n5);
+	return e;
+}
+
+int
+sweet_a05s_charger_kick(void)
+{
+	uint8_t r1, n1;
+
+	if (!i2c1_ready || sweet_i2c1_read(UPM6918_ADDR, UPM_REG01, &r1, 1)) {
+		return ENXIO;
+	}
+	n1 = (uint8_t)((r1 & ~0x20u) | 0x10u | 0x40u);
+	return sweet_i2c1_write(UPM6918_ADDR, UPM_REG01, n1);
+}
