+ * never blocks (try-lock) so it is usable from the panic path and from a
+ * driver that is about to touch hardware that can hang the SoC.
+ */
+void
+sweet_log_sync(void)
+{
+	if (!su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total != sweet_log_flushed) {
+		(void)sweet_log_dump_locked(total);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
